{
  "name": "@pothooks/core",
  "version": "0.0.0",
  "description": "Animate handwriting on the web — framework-agnostic runtime",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pothooks/pothooks-animate.git",
    "directory": "packages/core"
  },
  "homepage": "https://pothooks.com",
  "keywords": [
    "handwriting",
    "signature",
    "animation",
    "svg",
    "smil",
    "pothooks"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
