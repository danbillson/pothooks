{
  "name": "pothooks-animate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && pnpm publish -r --access public --no-git-checks --report-summary"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  }
}
